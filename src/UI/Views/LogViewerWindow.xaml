<Window x:Class="IISDeploy.UI.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Viewer — IISDeploy Studio"
        Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="#30363D" BorderThickness="1" CornerRadius="8" Background="#0D1117">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Grid Grid.Row="0" Background="#161B22" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="📋" FontSize="16" Foreground="#4CC2FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="System Logs" FontSize="14" FontWeight="Bold" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBox x:Name="FilterBox" Width="200" Height="28" Margin="0,0,16,0"
                             Background="#0D1117" Foreground="#E6EDF3" BorderBrush="#30363D"
                             TextChanged="FilterBox_TextChanged"/>
                    <CheckBox x:Name="AutoScrollChk" Content="Auto-scroll" IsChecked="True" Foreground="#8B949E" Margin="0,0,16,0"/>
                    <Button x:Name="RefreshBtn" Content="Refresh" Width="70" Height="28" Margin="0,0,8,0"
                            Background="#1F6FEB" Foreground="White" BorderThickness="0"
                            Click="RefreshBtn_Click"/>
                    <Button x:Name="ClearBtn" Content="Clear" Width="70" Height="28"
                            Background="Transparent" Foreground="#8B949E" BorderBrush="#30363D" BorderThickness="1"
                            Click="ClearBtn_Click"/>
                </StackPanel>
                
                <Button Grid.Column="3" Content="✕" Width="40" Background="Transparent" Foreground="#8B949E" BorderThickness="0"
                        Click="CloseBtn_Click"/>
            </Grid>

            <Rectangle Grid.Row="1" Fill="#30363D"/>

            <!-- Log Output -->
            <ListBox x:Name="LogList" Grid.Row="2" Margin="8"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- In code behind we can syntax highlight this, for now simple binding -->
                        <TextBlock Text="{Binding}" Foreground="#C9D1D9" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#161B22"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</Window>
