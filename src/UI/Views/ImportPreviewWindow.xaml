<Window x:Class="IISDeploy.UI.Views.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Preview" Height="900" MinHeight="900" Width="980"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <!-- Custom Window Chrome for Dialog -->
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="8"
            Background="{DynamicResource BackgroundBrush}"
            Effect="{StaticResource CardShadow}">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Custom Header -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarGradientBrush}"
                    CornerRadius="7,7,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="📦" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="Import Package Preview" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <!-- Small close button top right (optional, since it's a dialog) -->
                </Grid>
            </Border>

            <!-- Top Row: Source Info & Content Summary -->
            <Grid Grid.Row="1" Margin="20,20,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="SOURCE ENVIRONMENT"/>
                        <UniformGrid Rows="2" Columns="2">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Machine" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SourceMachine}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="OS" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SourceOs}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="IIS Version" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SourceIis}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Exported" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding ExportDate}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="CONTENT SUMMARY"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sites" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Sites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="🌐 " Foreground="{DynamicResource PrimaryBrush}" FontSize="10"/>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="App Pools" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding Pools}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="⬡ " Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Path Configuration -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="20,10,20,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="SITE PHYSICAL PATHS"/>
                    <ItemsControl ItemsSource="{Binding SitePaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceHighBrush}"
                                        CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding SiteName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="   Original: " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding OriginalPath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="Target:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Width="45"/>
                                            <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="380" Margin="0,0,16,0"/>
                                            <CheckBox IsChecked="{Binding CreateIfMissing}" VerticalAlignment="Center">
                                                <TextBlock Text="Create if missing" FontSize="11"/>
                                            </CheckBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Conflicts -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="20,10,20,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="CONFLICTS &amp; RESOLUTION" Margin="0" VerticalAlignment="Center"/>
                        
                        <!-- Status indicator -->
                        <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="4"
                                Background="#F59E0B20"
                                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Conflicts Detected" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                        
                        <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="4"
                                Background="#10B98120"
                                Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="Clear" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <ItemsControl ItemsSource="{Binding Conflicts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceHighBrush}"
                                            BorderBrush="{DynamicResource WarningBrush}"
                                            BorderThickness="3,0,0,0"
                                            CornerRadius="0,6,6,0" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock>
                                                    <Run Text="{Binding ObjectType}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Run Text=": " Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <Run Text="{Binding ObjectName}" Foreground="{DynamicResource AccentBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            
                                            <ComboBox Grid.Row="0" Grid.Column="1"
                                                      ItemsSource="{Binding AvailableStrategies}"
                                                      SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"/>
                                                      
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding ShowCustomName, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="New Name:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                                            </StackPanel>
                                            
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding ShowCustomPort, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="New Port:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding CustomPort, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Actions -->
            <Border Grid.Row="4" Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,7,7" Padding="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Width="100" Margin="0,0,12,0"/>
                    <Button Content="Import" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Width="120"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
