<Window x:Class="IISDeploy.UI.Views.ScanResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dependency Scan Results" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Summary Alert -->
        <Border Grid.Row="0" Margin="20,20,20,10" Padding="16" CornerRadius="6"
                Background="{DynamicResource AlertErrorBackground}" BorderBrush="{DynamicResource AlertErrorText}" BorderThickness="1"
                x:Name="SummaryAlert">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="24" Foreground="{DynamicResource AlertErrorText}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryTitle" Text="Dependencies Missing" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AlertErrorText}"/>
                    <TextBlock x:Name="SummaryText" Text="Scan complete. Found: 12, Missing: 6." FontSize="12" Foreground="{DynamicResource AlertErrorText}" Margin="0,2,0,0" Opacity="0.9"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Lists -->
        <Grid Grid.Row="1" Margin="20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Missing -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="MISSING DEPENDENCIES"/>
                    
                    <ScrollViewer Grid.Row="1" Margin="0,5,0,0">
                        <ItemsControl x:Name="MissingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceHighBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="❌" FontSize="10" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Type, StringFormat=' ({0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DownloadUrl}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="20,2,0,0"
                                                       Cursor="Hand" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Warnings/Errors -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0" x:Name="WarningsBorder">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeader}" Text="SCANNER WARNINGS"/>
                    
                    <ScrollViewer Grid.Row="1" Margin="0,5,0,0">
                        <ItemsControl x:Name="WarningList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EF444415" BorderBrush="#EF444440" BorderThickness="1,0,0,0" Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
            <Button Content="Close" Style="{StaticResource PrimaryButton}" Width="80" Padding="10,6" HorizontalAlignment="Right"
                    Click="CloseBtn_Click"/>
        </Border>
    </Grid>
</Window>
