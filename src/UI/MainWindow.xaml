<Window x:Class="IISDeploy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="IISDeploy Studio"
        Height="760" Width="1300"
        MinHeight="600" MinWidth="960"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>   <!-- Toolbar + Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="32"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════
             ROW 0 — Toolbar + Summary Cards
        ════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Toolbar Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button x:Name="RefreshBtn" Style="{StaticResource ToolbarButton}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻ " FontSize="13"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource BorderBrush}"
                               Margin="6,10" VerticalAlignment="Stretch"/>

                    <Button x:Name="ExportBtn" Style="{StaticResource ToolbarButton}"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↑ " FontSize="13" Foreground="#38BDF8"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ImportBtn" Style="{StaticResource ToolbarButton}"
                            Command="{Binding ImportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓ " FontSize="13" Foreground="#10B981"/>
                            <TextBlock Text="Import"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Fill="{DynamicResource BorderBrush}"
                               Margin="6,10" VerticalAlignment="Stretch"/>

                    <Button x:Name="DependencyBtn" Style="{StaticResource ToolbarButton}"
                            Command="{Binding ScanDependenciesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬡ " FontSize="12" Foreground="#F59E0B"/>
                            <TextBlock Text="Scan"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LogViewBtn" Style="{StaticResource ToolbarButton}"
                            Click="LogViewBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="≡ " FontSize="13"/>
                            <TextBlock Text="Logs"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReportViewBtn" Style="{StaticResource ToolbarButton}"
                            Click="ReportViewBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦ " FontSize="12"/>
                            <TextBlock Text="Reports"/>
                        </StackPanel>
                    </Button>
                </StackPanel>



                <!-- Summary Cards -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,4,0">

                    <!-- Sites Card -->
                    <Border Margin="4,0" Padding="14,6" CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SITES" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding ServerSummary.TotalSites}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Running Card -->
                    <Border Margin="4,0" Padding="14,6" CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="RUNNING" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ServerSummary.RunningSites}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Stopped Card -->
                    <Border Margin="4,0" Padding="14,6" CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}"
                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="STOPPED" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ServerSummary.StoppedSites}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- App Pools Card -->
                    <Border Margin="4,0" Padding="14,6" CornerRadius="8"
                            Background="{DynamicResource SurfaceElevatedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="APP POOLS" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding ServerSummary.TotalAppPools}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Theme Toggle -->
                    <Button x:Name="DarkModeBtn" Style="{StaticResource IconButton}"
                            Width="36" Height="36" Margin="6,0,0,0"
                            Click="DarkModeBtn_Click"
                            ToolTip="Toggle Theme">
                        <TextBlock x:Name="ThemeIcon" Text="☀" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════
             ROW 1 — Main Content
        ════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Left Sidebar ─── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬡ " FontSize="12" Foreground="{DynamicResource PrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="IIS SITES" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Site Tree -->
                    <TreeView Grid.Row="1"
                              ItemsSource="{Binding Sites}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="6,4">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsChecked}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"/>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="1" Width="7" Height="7"
                                             Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Started">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Stopped">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <!-- Children count badge -->
                                    <Border Grid.Column="3"
                                            CornerRadius="8" Padding="5,1"
                                            Margin="6,0,0,0"
                                            Background="{DynamicResource SurfaceHighBrush}"
                                            Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ChildCount}"
                                                   FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          VerticalAlignment="Stretch"/>

            <!-- ─── Right Content Area ─── -->
            <Grid Grid.Column="2" Margin="18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Server Info Card -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="SERVER" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderBrush}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Metric Cards Row -->
                        <UniformGrid Grid.Row="1" Rows="1" Columns="4">

                            <!-- Machine -->
                            <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource SurfaceHighBrush}">
                                <StackPanel>
                                    <TextBlock Text="🖥" FontSize="18" Margin="0,0,0,6"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ServerSummary.MachineName}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Machine" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- OS -->
                            <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource SurfaceHighBrush}">
                                <StackPanel>
                                    <TextBlock Text="🪟" FontSize="18" Margin="0,0,0,6"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding ServerSummary.OsVersion}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="OS" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- IIS Version -->
                            <Border Margin="0,0,8,0" Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource SurfaceHighBrush}">
                                <StackPanel>
                                    <TextBlock Text="⚙" FontSize="18" Margin="0,0,0,6"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding ServerSummary.IisVersion}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="IIS Version" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Last Scan -->
                            <Border Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource SurfaceHighBrush}">
                                <StackPanel>
                                    <TextBlock Text="🕒" FontSize="18" Margin="0,0,0,6"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <Binding Path="ServerSummary.LastScan"
                                                     StringFormat="{}{0:HH:mm}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Text="Last Scan" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- Detail Placeholder -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⬡" FontSize="52"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4F8EF7" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                        <TextBlock Text="Select a site to view details"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Use the left panel to browse IIS sites"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════
             ROW 2 — Status Bar
        ════════════════════════════════════════ -->
        <StatusBar Grid.Row="2" Style="{StaticResource StatusBarStyle}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <!-- Animated status dot -->
                    <Ellipse Width="7" Height="7"
                             VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessage,
                                        Converter={StaticResource BoolToVisibility},
                                        ConverterParameter=error}" Value="Visible">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="IISDeploy Studio · v1.1.5"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <ProgressBar Width="140" Height="3"
                                 Value="{Binding ProgressValue}"
                                 Maximum="100"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Margin="0,0,8,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
